generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum EnrollmentStatus {
  ACTIVE
  PENDING
  COMPLETED
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum DebateSessionStatus {
  SCHEDULED
  ACTIVE
  CLOSED
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String?  @unique
  passwordHash        String
  role                Role
  avatarUrl           String?
  isActive            Boolean  @default(true)
  canModerateDebates  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  studentProfile         StudentProfile?
  teacherProfile         TeacherProfile?
  auditLogs              AuditLog[]         @relation("AuditActor")
  notifications          Notification[]
  moderatedDebates       DebateSession[]    @relation("SessionModerator")
  debateEvaluationsGiven DebateEvaluation[] @relation("DebateEvaluator")
}

model StudentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  studentNumber String   @unique
  studentCode   String   @unique
  level         String
  phone         String?
  guardianName  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments          Enrollment[]
  attendances          Attendance[]
  grades               Grade[]
  invoices             Invoice[]
  receipts             Receipt[]
  debateEvaluations    DebateEvaluation[]
  debateParticipations DebateParticipant[]
  debateProposals      DebateProposal[]
}

model TeacherProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  staffNumber String   @unique
  specialty   String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroups ClassGroup[]
  materials   StudyMaterial[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  level       String
  description String?
  duration    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classGroups    ClassGroup[]
  enrollments    Enrollment[]
  studyMaterials StudyMaterial[]
}

model ClassGroup {
  id        String    @id @default(cuid())
  name      String
  room      String?
  schedule  String
  courseId  String
  teacherId String?
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course      Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacher     TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  attendances Attendance[]
  grades      Grade[]

  @@index([courseId])
  @@index([teacherId])
}

model Enrollment {
  id           String           @id @default(cuid())
  studentId    String
  courseId     String
  classGroupId String
  status       EnrollmentStatus @default(ACTIVE)
  enrolledAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  classGroup ClassGroup     @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  invoices   Invoice[]

  @@unique([studentId, classGroupId])
  @@index([courseId])
  @@index([classGroupId])
}

model Attendance {
  id           String           @id @default(cuid())
  studentId    String
  classGroupId String
  lessonDate   DateTime
  status       AttendanceStatus @default(PRESENT)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup ClassGroup     @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@unique([studentId, classGroupId, lessonDate])
  @@index([classGroupId])
}

model Grade {
  id           String   @id @default(cuid())
  studentId    String
  classGroupId String
  title        String
  score        Float
  maxScore     Float    @default(20)
  weight       Float    @default(1)
  gradedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup ClassGroup     @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classGroupId])
}

model StudyMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  unit        String?
  fileUrl     String?
  courseId    String
  teacherId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([teacherId])
}

model Invoice {
  id           String        @id @default(cuid())
  studentId    String
  enrollmentId String?
  reference    String        @unique
  amountMt     Int
  status       InvoiceStatus @default(PENDING)
  dueDate      DateTime
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment Enrollment?    @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  receipt    Receipt?

  @@index([studentId])
  @@index([enrollmentId])
  @@index([status])
}

model Receipt {
  id            String   @id @default(cuid())
  invoiceId     String   @unique
  studentId     String
  amountMt      Float
  issuedAt      DateTime @default(now())
  issuedBy      String
  receiptNumber String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoice Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([receiptNumber])
}

model DebateSession {
  id          String              @id @default(cuid())
  topic       String
  startsAt    DateTime
  capacity    Int
  location    String?
  status      DebateSessionStatus @default(SCHEDULED)
  moderatorId String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  moderator    User?               @relation("SessionModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  evaluations  DebateEvaluation[]
  participants DebateParticipant[]
}

model DebateParticipant {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  joinedAt  DateTime @default(now())

  session DebateSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model DebateEvaluation {
  id             String    @id @default(cuid())
  sessionId      String
  studentId      String
  evaluatorId    String?
  fluency        Int
  argumentation  Int
  posture        Int
  feedback       String?
  acknowledgedAt DateTime?
  evaluatedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  session       DebateSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student       StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluator     User?            @relation("DebateEvaluator", fields: [evaluatorId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity])
}

model DebateProposal {
  id        String   @id @default(cuid())
  studentId String
  topic     String
  reason    String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  title        String
  message      String
  type         String   @default("INFO") // INFO, SUCCESS, WARNING, DANGER, DEBATE_FEEDBACK
  isRead       Boolean  @default(false)
  evaluationId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluation DebateEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([evaluationId])
}
