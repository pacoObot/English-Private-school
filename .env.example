# ============================================
# BANCO DE DADOS
# ============================================
# Variáveis para conectar ao PostgreSQL
DATABASE_URL="postgresql://delson:delson_dev_password@postgres:5432/delson_ps?schema=public"
DATABASE_HOST="postgres"
DATABASE_PORT="5432"
POSTGRES_USER="delson"
POSTGRES_PASSWORD="delson_dev_password"
POSTGRES_DB="delson_ps"

# ============================================
# APLICAÇÃO NEXT.JS
# ============================================
# Ambiente
NODE_ENV="development"

# Locale padrão
NEXT_PUBLIC_DEFAULT_LOCALE="pt-PT"

# Segredo de autenticação (ALTERAR EM PRODUÇÃO!)
# Gerar com: `openssl rand -base64 32`
AUTH_SECRET="local-dev-secret-change-before-production-delson-ps"

# ============================================
# DOCKER
# ============================================
# Portas
APP_PORT="3000"
DB_PORT="5432"

# Compose files
COMPOSE_FILE="docker-compose.yml"
# Para produção: COMPOSE_FILE="docker-compose.prod.yml"
